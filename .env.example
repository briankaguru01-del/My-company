# URL that the Diagnostic Intake Form submits to (server-side only).
# This should point to your internal submission endpoint (e.g. a Google
# Apps Script Web App URL, or a middleware service that writes to Google
# Sheets). Never expose this as a NEXT_PUBLIC_ variable.
FORM_SUBMISSION_URL=https://example.com/your-submission-endpoint

# Optional: Google Analytics / GA4 measurement ID.
# If unset, analytics calls are safely skipped (no hard dependency).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: base URL of the deployed site, used for sitemap/robots/OG tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com
